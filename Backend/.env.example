DECIFRA_AMBIENTE=desenvolvimento
DECIFRA_ORIGENS_PERMITIDAS=["http://localhost:5173","http://127.0.0.1:5173"]
# Valores fictícios; substituir localmente antes de aplicar migrações.
DECIFRA_POSTGRESQL_URL=postgresql://decifra:senha_ficticia@127.0.0.1:5432/decifra
DECIFRA_MONGODB_URL=mongodb://127.0.0.1:27017
DECIFRA_MONGODB_BANCO=decifra
# Login Google: preencher somente no arquivo privado .env.
# Usar sempre o mesmo endereço no navegador, no Google e nesta configuração.
DECIFRA_ORIGEM_PUBLICA=http://localhost:5173
DECIFRA_GOOGLE_CLIENTE_ID=
DECIFRA_GOOGLE_CLIENTE_SEGREDO=
# Validade absoluta; sair revoga a sessão antes deste prazo.
DECIFRA_SESSAO_DIAS=7
