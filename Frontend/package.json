{
  "name": "decifra-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "testar-interrupcoes": "playwright test",
    "testar-menu": "playwright test --config playwright.menu.config.ts",
    "testar-perfil": "playwright test --config playwright.perfil.config.ts",
    "formatar": "prettier --write .",
    "verificar-formatacao": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
